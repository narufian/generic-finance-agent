# Sandbox for file inspection and code execution (required).
E2B_API_KEY=

# Model provider key. Only the keys for providers used by the models below are required.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=   # for openrouter:... models (needs: uv add "pydantic-ai-slim[openrouter]")
# OPENAI_API_KEY=       # for openai:... models     (needs: uv add "pydantic-ai-slim[openai]")
# Bedrock / Vertex use their SDK credential chains (AWS profile, gcloud ADC); no key here.

# Optional model overrides (PydanticAI "provider:model" strings).
# FINANCE_AGENT_MODEL=anthropic:claude-sonnet-4-6
# FINANCE_AGENT_OPUS_MODEL=anthropic:claude-opus-4-6
# FINANCE_AGENT_REVIEW_MODEL=anthropic:claude-sonnet-4-6
# FINANCE_AGENT_FAST_REVIEW_MODEL=anthropic:claude-haiku-4-5
# FINANCE_AGENT_TRIAGE_MODEL=anthropic:claude-haiku-4-5
# FINANCE_AGENT_REPORT_REVIEW_MODEL=anthropic:claude-sonnet-4-6  # defaults to FINANCE_AGENT_MODEL
# FINANCE_AGENT_AGENT_REQUEST_LIMIT=200
# FINANCE_AGENT_JOB_TIMEOUT_SECONDS=1800
# FINANCE_AGENT_CHAT_MODEL=anthropic:claude-haiku-4-5  # defaults to FINANCE_AGENT_MODEL
